[Unit]
Description=Heliopause typed resolver network-policy helper
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/heliopause/haa-network-policy-helper
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/heliopause-network-policy
RuntimeDirectory=heliopause-network-policy
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
