{
  "rules": [
    {
      "id": "haa-s04-js-credential-body",
      "languages": [
        "javascript",
        "typescript"
      ],
      "message": "Suspicious artifact behavior requires review; this pattern alone is not a malware verdict.",
      "severity": "WARNING",
      "metadata": {
        "rule_version": 1,
        "disposition": "manual-review"
      },
      "mode": "taint",
      "pattern-sources": [
        {
          "patterns": [
            {
              "pattern": "process.env.$NAME"
            },
            {
              "metavariable-regex": {
                "metavariable": "$NAME",
                "regex": "(?i).*(token|secret|password|private.?key|access.?key).*"
              }
            }
          ]
        },
        {
          "patterns": [
            {
              "pattern": "process.env[$KEY]"
            },
            {
              "metavariable-regex": {
                "metavariable": "$KEY",
                "regex": "(?i).*(token|secret|password|private.?key|access.?key).*"
              }
            }
          ]
        },
        {
          "patterns": [
            {
              "pattern": "fs.readFileSync($PATH, ...)"
            },
            {
              "metavariable-regex": {
                "metavariable": "$PATH",
                "regex": "(?i).*(?:\\.npmrc|\\.pypirc|\\.env(?:\\.[^/]*)?|\\.aws/credentials|\\.ssh/id_[^/]*).*"
              }
            }
          ]
        }
      ],
      "pattern-sinks": [
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "fetch($URL, {..., body: $DATA, ...})"
                },
                {
                  "pattern": "axios.post($URL, $DATA, ...)"
                }
              ]
            },
            {
              "focus-metavariable": "$DATA"
            }
          ]
        }
      ]
    },
    {
      "id": "haa-s04-py-credential-body",
      "languages": [
        "python"
      ],
      "message": "Suspicious artifact behavior requires review; this pattern alone is not a malware verdict.",
      "severity": "WARNING",
      "metadata": {
        "rule_version": 1,
        "disposition": "manual-review"
      },
      "mode": "taint",
      "pattern-sources": [
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "os.environ[$KEY]"
                },
                {
                  "pattern": "os.getenv($KEY, ...)"
                }
              ]
            },
            {
              "metavariable-regex": {
                "metavariable": "$KEY",
                "regex": "(?i).*(token|secret|password|private.?key|access.?key).*"
              }
            }
          ]
        },
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "open($PATH, ...).read(...)"
                },
                {
                  "pattern": "pathlib.Path($PATH).read_text(...)"
                },
                {
                  "pattern": "pathlib.Path($PATH).read_bytes(...)"
                }
              ]
            },
            {
              "metavariable-regex": {
                "metavariable": "$PATH",
                "regex": "(?i).*(?:\\.npmrc|\\.pypirc|\\.env(?:\\.[^/]*)?|\\.aws/credentials|\\.ssh/id_[^/]*).*"
              }
            }
          ]
        }
      ],
      "pattern-sinks": [
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "requests.post($URL, data=$DATA, ...)"
                },
                {
                  "pattern": "requests.post($URL, json=$DATA, ...)"
                }
              ]
            },
            {
              "focus-metavariable": "$DATA"
            }
          ]
        }
      ]
    },
