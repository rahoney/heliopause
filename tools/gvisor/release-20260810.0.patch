+// EmitMountTopologyMutation reports a successful mount-namespace mutation.
+// The remote sink's existing drop accounting applies to this required event.
+func EmitMountTopologyMutation(t *kernel.Task) {
+	if !seccheck.Global.Enabled(seccheck.PointMountTopologyMutation) {
+		return
+	}
+	fields := seccheck.Global.GetFieldSet(seccheck.PointMountTopologyMutation)
+	evt := &pb.MountTopologyMutation{MountNamespaceId: t.MountNamespace().ID}
+	if !fields.Context.Empty() {
+		evt.ContextData = &pb.ContextData{}
+		kernel.LoadSeccheckData(t, fields.Context, evt.ContextData)
+	}
+	_ = seccheck.Global.SentToSinks(func(c seccheck.Sink) error {
+		return c.MountTopologyMutation(t, fields, evt)
+	})
+}
