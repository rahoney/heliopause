+// MountTopology returns the complete reachable mount tree rooted at mntns.
+// Callers must treat any error as an incomplete topology, never as an empty one.
+func (mntns *MountNamespace) MountTopology(ctx context.Context) ([]MountTopologyEntry, error) {
+	root := mntns.Root(ctx)
+	if !root.Ok() {
+		return nil, linuxerr.ENOENT
+	}
+	defer root.DecRef(ctx)
+	mntns.vfs.lockMounts()
+	mounts := root.mount.submountsLocked()
+	for _, mnt := range mounts {
+		mnt.IncRef()
+	}
+	mntns.vfs.unlockMounts(ctx)
+	defer func() {
+		for _, mnt := range mounts {
+			mnt.DecRef(ctx)
+		}
+	}()
+	if len(mounts) == 0 {
+		return nil, linuxerr.ENOENT
+	}
+	entries := make([]MountTopologyEntry, 0, len(mounts))
+	for _, mnt := range mounts {
+		vd := VirtualDentry{mount: mnt, dentry: mnt.root}
+		path, err := mntns.vfs.PathnameReachable(ctx, root, vd)
+		if err != nil || path == "" {
+			if err != nil {
+				return nil, err
+			}
+			return nil, linuxerr.ENOENT
+		}
+		opts := mnt.Options()
+		parentID := mnt.ID
+		if parent := mnt.parent(); parent != nil {
+			parentID = parent.ID
+		}
+		entries = append(entries, MountTopologyEntry{ID: mnt.ID, ParentID: parentID, Mountpoint: path, FilesystemType: mnt.fs.FilesystemType().Name(), ReadOnly: opts.ReadOnly, NoExec: opts.Flags.NoExec, NoSUID: opts.Flags.NoSUID, NoDev: opts.Flags.NoDev})
+	}
+	return entries, nil
+}
