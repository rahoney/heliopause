+// emitMountTopologySnapshot emits one complete initial namespace topology before
+// the root task can execute userspace code.
+func (l *Loader) emitMountTopologySnapshot(t *kernel.Task) error {
+	if !seccheck.Global.Enabled(seccheck.PointMountTopologySnapshot) {
+		return nil
+	}
+	ns := t.MountNamespace()
+	entries, err := ns.MountTopology(context.Background())
+	if err != nil {
+		return err
+	}
+	if len(entries) > 64 {
+		return fmt.Errorf("mount topology exceeds 64 mounts")
+	}
+	evt := pb.MountTopologySnapshot{MountNamespaceId: ns.ID, SnapshotComplete: true}
+	fields := seccheck.Global.GetFieldSet(seccheck.PointMountTopologySnapshot)
+	if !fields.Context.Empty() {
+		evt.ContextData = &pb.ContextData{}
+		kernel.LoadSeccheckData(t, fields.Context, evt.ContextData)
+	}
+	for _, entry := range entries {
+		if len(entry.Mountpoint) > 512 || len(entry.FilesystemType) > 32 {
+			return fmt.Errorf("mount topology entry exceeds bounds")
+		}
+		evt.Mounts = append(evt.Mounts, &pb.MountTopologyEntry{MountId: entry.ID, ParentMountId: entry.ParentID, Mountpoint: entry.Mountpoint, FilesystemType: entry.FilesystemType, ReadOnly: entry.ReadOnly, Noexec: entry.NoExec, Nosuid: entry.NoSUID, Nodev: entry.NoDev})
+	}
+	if proto.Size(&evt) > 64<<10 {
+		return fmt.Errorf("mount topology snapshot exceeds 64 KiB")
+	}
+	return seccheck.Global.SentToSinks(func(c seccheck.Sink) error { return c.MountTopologySnapshot(context.Background(), fields, &evt) })
+}
