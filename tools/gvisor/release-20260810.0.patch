+type snapshotTestSink struct {
+	seccheck.SinkDefaults
+	mu        sync.Mutex
+	snapshots []*pb.MountTopologySnapshot
+}
+
+func (s *snapshotTestSink) Name() string { return "snapshot-test-sink" }
+func (s *snapshotTestSink) MountTopologySnapshot(_ context.Context, _ seccheck.FieldSet, info *pb.MountTopologySnapshot) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.snapshots = append(s.snapshots, proto.Clone(info).(*pb.MountTopologySnapshot))
+	return nil
+}
+
+func TestMountTopologySnapshotEmission(t *testing.T) {
+	sink := &snapshotTestSink{}
+	seccheck.Global.AppendSink(sink, []seccheck.PointReq{
+		{Pt: seccheck.PointMountTopologySnapshot, Fields: seccheck.FieldSet{}},
+	})
+
+	l, cleanup, err := createLoader(testConfig(), testSpec())
+	if err != nil {
+		t.Fatalf("error creating loader: %v", err)
+	}
+	defer l.Destroy()
+	defer cleanup()
+
+	// Snapshot must not be emitted before Run
+	sink.mu.Lock()
+	if len(sink.snapshots) != 0 {
+		t.Fatalf("expected 0 snapshots before Run, got %d", len(sink.snapshots))
+	}
+	sink.mu.Unlock()
+
+	var resultChanErr error
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		resultChanErr = <-l.ctrl.manager.startResultChan
+		wg.Done()
+	}()
+
+	if err := l.Run(); err != nil {
+		t.Fatalf("Run failed: %v", err)
+	}
+
+	wg.Wait()
+	if resultChanErr != nil {
+		t.Fatalf("startResultChan error: %v", resultChanErr)
+	}
+
+	// Immediately upon Run, exactly 1 complete snapshot must be emitted
+	sink.mu.Lock()
+	if len(sink.snapshots) != 1 {
+		t.Fatalf("expected exactly 1 snapshot upon Run, got %d", len(sink.snapshots))
+	}
+	snap := sink.snapshots[0]
+	sink.mu.Unlock()
+
+	if !snap.SnapshotComplete {
+		t.Errorf("expected SnapshotComplete=true")
+	}
+	if snap.MountNamespaceId == 0 {
+		t.Errorf("expected non-zero MountNamespaceId")
+	}
+	if len(snap.Mounts) == 0 {
+		t.Errorf("expected at least 1 mount in snapshot")
+	}
+	if len(snap.Mounts) > 64 {
+		t.Errorf("mount count %d exceeds bound 64", len(snap.Mounts))
+	}
+	hasRoot := false
+	for _, m := range snap.Mounts {
+		if len(m.Mountpoint) > 512 {
+			t.Errorf("mountpoint %q exceeds bound 512", m.Mountpoint)
+		}
+		if len(m.FilesystemType) > 32 {
+			t.Errorf("fs type %q exceeds bound 32", m.FilesystemType)
+		}
+		if m.Mountpoint == "/" {
+			hasRoot = true
+		}
+	}
+	if !hasRoot {
+		t.Errorf("expected root mount ('/') in snapshot")
+	}
+
+	// Wait for application exit
+	if status := l.WaitExit(); !status.Exited() || status.ExitStatus() != 0 {
+		t.Errorf("application exited with %s, want 0", status)
+	}
+
+	// Confirm no second snapshot was emitted in normal session
+	sink.mu.Lock()
+	if len(sink.snapshots) != 1 {
+		t.Errorf("expected still exactly 1 snapshot after exit, got %d", len(sink.snapshots))
+	}
+	sink.mu.Unlock()
+}
