+
+	// D. symlink whose lexical location differs from actual target
+	addrSymlink := mapString(t, task1, "/symlink_to_child")
+	fdD, _, err := openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrSymlink, linux.O_RDONLY, 0)
+	if err != nil || fdD < 0 {
+		t.Fatalf("D: openat symlink failed: %v", err)
+	}
+	verifyResult("D. Symlink resolving to target", true, 0, "/testdir/childfile", rootMountID)
+
+	// E. .. resolution
+	addrDotDot := mapString(t, task1, "/testdir/../testfile")
+	fdE, _, err := openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrDotDot, linux.O_RDONLY, 0)
+	if err != nil || fdE < 0 {
+		t.Fatalf("E: openat .. failed: %v", err)
+	}
+	verifyResult("E. DotDot resolution", true, 0, "/testfile", rootMountID)
+
+	// F. ENOENT
+	addrNoEnt := mapString(t, task1, "/nonexistent_file")
+	_, _, err = openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrNoEnt, linux.O_RDONLY, 0)
+	if err == nil {
+		t.Fatalf("F: expected ENOENT, got nil")
+	}
+	verifyResult("F. ENOENT", false, int64(unix.ENOENT), "", 0)
+
+	// G. ENOTDIR
+	addrNotDir := mapString(t, task1, "/testfile/cannot_be_dir")
+	_, _, err = openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrNotDir, linux.O_RDONLY, 0)
+	if err == nil {
+		t.Fatalf("G: expected ENOTDIR, got nil")
+	}
+	verifyResult("G. ENOTDIR", false, int64(unix.ENOTDIR), "", 0)
