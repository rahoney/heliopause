+func TestRemoteNewEvents(t *testing.T) {
+	server, err := test.NewServer()
+	if err != nil {
+		t.Fatalf("newServer(): %v", err)
+	}
+	defer server.Close()
+
+	endpoint, err := setup(server.Endpoint)
+	if err != nil {
+		t.Fatalf("setup(): %v", err)
+	}
+	endpointFD, err := fd.NewFromFile(endpoint)
+	if err != nil {
+		_ = endpoint.Close()
+		t.Fatalf("NewFromFile(): %v", err)
+	}
+	_ = endpoint.Close()
+
+	r, err := new(nil, endpointFD)
+	if err != nil {
+		t.Fatalf("New(): %v", err)
+	}
+
+	// 1. Test OpenResult serialization
+	openResult := &pb.OpenResult{
+		Sysno:            257,
+		Flags:            0x80000,
+		Errorno:          0,
+		ResolvedPathname: "/etc/passwd",
+		MountId:          12,
+		Success:          true,
+		ContextData: &pb.ContextData{
+			ThreadId:          42,
+			ThreadStartTimeNs: 123456789,
+			ThreadGroupId:     42,
+			ProcessName:       "cat",
+		},
+	}
+	if err := r.OpenResult(nil, seccheck.FieldSet{}, openResult); err != nil {
+		t.Fatalf("OpenResult: %v", err)
+	}
+
+	// 2. Test MountTopologySnapshot serialization
+	snapshot := &pb.MountTopologySnapshot{
+		MountNamespaceId: 1001,
+		SnapshotComplete: true,
+		Mounts: []*pb.MountTopologyEntry{
+			{
+				MountId:        1,
+				ParentMountId:  1,
+				Mountpoint:     "/",
+				FilesystemType: "tmpfs",
+				ReadOnly:       false,
+				Noexec:         false,
+				Nosuid:         true,
+				Nodev:          true,
+			},
+			{
+				MountId:        2,
+				ParentMountId:  1,
+				Mountpoint:     "/proc",
+				FilesystemType: "procfs",
+				ReadOnly:       true,
+				Noexec:         true,
+				Nosuid:         true,
+				Nodev:          true,
+			},
+		},
+		ContextData: &pb.ContextData{
+			ThreadId: 1,
+		},
+	}
+	if err := r.MountTopologySnapshot(nil, seccheck.FieldSet{}, snapshot); err != nil {
+		t.Fatalf("MountTopologySnapshot: %v", err)
+	}
+
+	// 3. Test MountTopologyMutation serialization
+	mutation := &pb.MountTopologyMutation{
+		MountNamespaceId: 1001,
+		ContextData: &pb.ContextData{
+			ThreadId: 42,
+		},
+	}
+	if err := r.MountTopologyMutation(nil, seccheck.FieldSet{}, mutation); err != nil {
+		t.Fatalf("MountTopologyMutation: %v", err)
+	}
+
+	server.WaitForCount(3)
+	pts := server.GetPoints()
+	if len(pts) != 3 {
+		t.Fatalf("expected 3 points, got %d", len(pts))
+	}
+
+	// Verify OpenResult
+	if want := pb.MessageType_MESSAGE_SYSCALL_OPEN_RESULT; pts[0].MsgType != want {
+		t.Errorf("wrong msg type for OpenResult, want %v, got %v", want, pts[0].MsgType)
+	}
+	gotOpen := &pb.OpenResult{}
+	if err := proto.Unmarshal(pts[0].Msg, gotOpen); err != nil {
+		t.Fatalf("Unmarshal OpenResult: %v", err)
+	}
+	if !proto.Equal(openResult, gotOpen) {
+		t.Errorf("OpenResult mismatch: want %+v, got %+v", openResult, gotOpen)
+	}
+
+	// Verify MountTopologySnapshot
+	if want := pb.MessageType_MESSAGE_SENTRY_MOUNT_TOPOLOGY_SNAPSHOT; pts[1].MsgType != want {
+		t.Errorf("wrong msg type for MountTopologySnapshot, want %v, got %v", want, pts[1].MsgType)
+	}
+	gotSnapshot := &pb.MountTopologySnapshot{}
+	if err := proto.Unmarshal(pts[1].Msg, gotSnapshot); err != nil {
+		t.Fatalf("Unmarshal MountTopologySnapshot: %v", err)
+	}
+	if !proto.Equal(snapshot, gotSnapshot) {
+		t.Errorf("MountTopologySnapshot mismatch: want %+v, got %+v", snapshot, gotSnapshot)
+	}
+
+	// Verify MountTopologyMutation
+	if want := pb.MessageType_MESSAGE_SENTRY_MOUNT_TOPOLOGY_MUTATION; pts[2].MsgType != want {
+		t.Errorf("wrong msg type for MountTopologyMutation, want %v, got %v", want, pts[2].MsgType)
+	}
+	gotMutation := &pb.MountTopologyMutation{}
+	if err := proto.Unmarshal(pts[2].Msg, gotMutation); err != nil {
+		t.Fatalf("Unmarshal MountTopologyMutation: %v", err)
+	}
+	if !proto.Equal(mutation, gotMutation) {
+		t.Errorf("MountTopologyMutation mismatch: want %+v, got %+v", mutation, gotMutation)
+	}
+}
