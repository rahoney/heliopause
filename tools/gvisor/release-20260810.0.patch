+func TestOpenResult(t *testing.T) {
+	task1, task2, sink, rootMountID := setupTestEnvironment(t)
+	expectedCount := 0
+
+	verifyResult := func(name string, shouldSucceed bool, expectedErrno int64, expectedPath string, expectedMountID uint64) *pb.OpenResult {
+		t.Helper()
+		expectedCount++
+		if got := sink.count(); got != expectedCount {
+			t.Fatalf("[%s] expected exactly %d OpenResult events, got %d", name, expectedCount, got)
+		}
+		res := sink.lastResult()
+		if res.Success != shouldSucceed {
+			t.Errorf("[%s] Success mismatch: want %v, got %v", name, shouldSucceed, res.Success)
+		}
+		if res.Errorno != expectedErrno {
+			t.Errorf("[%s] Errorno mismatch: want %d, got %d", name, expectedErrno, res.Errorno)
+		}
+		if res.ResolvedPathname != expectedPath {
+			t.Errorf("[%s] ResolvedPathname mismatch: want %q, got %q", name, expectedPath, res.ResolvedPathname)
+		}
+		if res.MountId != expectedMountID {
+			t.Errorf("[%s] MountId mismatch: want %d, got %d", name, expectedMountID, res.MountId)
+		}
+		if res.ContextData == nil {
+			t.Errorf("[%s] ContextData missing", name)
+		} else if res.ContextData.ThreadId == 0 {
+			t.Errorf("[%s] ContextData ThreadId unpopulated", name)
+		}
+		return res
+	}
+
+	// A. successful absolute open
+	addrA := mapString(t, task1, "/testfile")
+	fdA, _, err := openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrA, linux.O_RDONLY, 0)
+	if err != nil || fdA < 0 {
+		t.Fatalf("A: openat failed: %v, fd=%d", err, fdA)
+	}
+	verifyResult("A. Successful absolute open", true, 0, "/testfile", rootMountID)
+
+	// B. real-dirfd relative open
+	addrDir := mapString(t, task1, "/testdir")
+	dirFD, _, err := openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrDir, linux.O_RDONLY|linux.O_DIRECTORY, 0)
+	if err != nil || dirFD < 0 {
+		t.Fatalf("B: openat dir failed: %v", err)
+	}
+	verifyResult("B. Open dir for dirfd", true, 0, "/testdir", rootMountID)
+
+	addrChild := mapString(t, task1, "childfile")
+	fdB, _, err := openat(task1, unix.SYS_OPENAT, int32(dirFD), addrChild, linux.O_RDONLY, 0)
+	if err != nil || fdB < 0 {
+		t.Fatalf("B: openat child via dirfd failed: %v", err)
+	}
+	verifyResult("B. Real-dirfd relative open", true, 0, "/testdir/childfile", rootMountID)
+
+	// C. AT_FDCWD relative open
+	// Change working directory of task1 to /testdir
