+	// H. Ordinary failure: EEXIST (O_CREAT | O_EXCL on existing file)
+	addrExist := mapString(t, task1, "/testfile")
+	_, _, err = openat(task1, unix.SYS_OPENAT, linux.AT_FDCWD, addrExist, linux.O_RDWR|linux.O_CREAT|linux.O_EXCL, 0644)
+	if err == nil {
+		t.Fatalf("H: expected EEXIST, got nil")
+	}
+	verifyResult("H. EEXIST", false, int64(unix.EEXIST), "", 0)
