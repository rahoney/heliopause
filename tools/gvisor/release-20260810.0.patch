+func TestMountTopologySnapshotAndMutations(t *testing.T) {
+	task, _, sink, rootMountID := setupTestEnvironment(t)
+	ctx := task
+	mntns := task.MountNamespace()
+
+	// 1. Initial snapshot validation
+	entries, err := mntns.MountTopology(ctx)
+	if err != nil {
+		t.Fatalf("MountTopology failed: %v", err)
+	}
+	if len(entries) != 1 {
+		t.Fatalf("Expected exactly 1 initial mount, got %d", len(entries))
+	}
+	if entries[0].ID != rootMountID {
+		t.Errorf("Root mount ID mismatch: want %d, got %d", rootMountID, entries[0].ID)
+	}
+	if entries[0].Mountpoint != "/" {
+		t.Errorf("Root mountpoint mismatch: want '/', got %q", entries[0].Mountpoint)
+	}
+	if entries[0].FilesystemType != "tmpfs" {
+		t.Errorf("Root fs type mismatch: want 'tmpfs', got %q", entries[0].FilesystemType)
+	}
+
+	// 2. Test Bounds Definition validation
+	// Bounds: <=64 mounts, mountpoint <= 512 bytes, filesystem type <= 32 bytes, encoded <= 64 KiB
+	longMountpoint := "/" + string(make([]byte, 513))
+	longType := string(make([]byte, 33))
+	if len(longMountpoint) <= 512 || len(longType) <= 32 {
+		t.Fatalf("Test setup error for bounds")
+	}
+
+	// Create mount target
+	addrMntDir := mapString(t, task, "/mnt_target")
+	popMntDir := &vfs.PathOperation{Root: mntns.Root(ctx), Start: mntns.Root(ctx), Path: fspath.Parse("/mnt_target")}
+	if err := task.Kernel().VFS().MkdirAt(ctx, task.Credentials(), popMntDir, &vfs.MkdirOptions{Mode: 0755}); err != nil {
+		t.Fatalf("MkdirAt /mnt_target failed: %v", err)
+	}
+
+	// 3. Test Mutation: Mount syscall
+	addrSource := mapString(t, task, "none")
+	addrType := mapString(t, task, "tmpfs")
+	mutBefore := sink.mutationCount()
+
+	mountArgs := makeArgs(uintptr(addrSource), uintptr(addrMntDir), uintptr(addrType), 0, 0, 0)
+	_, _, err = Mount(task, unix.SYS_MOUNT, mountArgs)
+	if err != nil {
+		t.Fatalf("Mount syscall failed: %v", err)
+	}
+	if sink.mutationCount() != mutBefore+1 {
+		t.Fatalf("Mount did not emit MountTopologyMutation: before=%d, after=%d", mutBefore, sink.mutationCount())
+	}
+	mut := sink.mutations[len(sink.mutations)-1]
+	if mut.MountNamespaceId != mntns.ID {
+		t.Errorf("MountTopologyMutation ID mismatch: want %d, got %d", mntns.ID, mut.MountNamespaceId)
+	}
+
+	// Verify updated topology contains 2 mounts and correct parent relationship
+	entries, err = mntns.MountTopology(ctx)
+	if err != nil {
+		t.Fatalf("MountTopology after mount failed: %v", err)
+	}
+	if len(entries) != 2 {
+		t.Fatalf("Expected 2 mounts after Mount, got %d", len(entries))
+	}
+	var subEntry *vfs.MountTopologyEntry
+	for i := range entries {
+		if entries[i].Mountpoint == "/mnt_target" {
+			subEntry = &entries[i]
+			break
+		}
+	}
+	if subEntry == nil {
+		t.Fatalf("Submount /mnt_target not found in topology: %+v", entries)
+	}
+	if subEntry.ParentID != rootMountID {
+		t.Errorf("Submount ParentID mismatch: want root %d, got %d", rootMountID, subEntry.ParentID)
+	}
+	if subEntry.ReadOnly {
+		t.Errorf("Expected writable submount initially")
+	}
+
+	// 4. Test Mutation: Remount branch (MS_REMOUNT | MS_RDONLY)
+	mutBefore = sink.mutationCount()
+	remountArgs := makeArgs(0, uintptr(addrMntDir), 0, uintptr(unix.MS_REMOUNT|unix.MS_RDONLY), 0, 0)
+	_, _, err = Mount(task, unix.SYS_MOUNT, remountArgs)
+	if err != nil {
+		t.Fatalf("Remount syscall failed: %v", err)
+	}
+	if sink.mutationCount() != mutBefore+1 {
+		t.Fatalf("Remount did not emit MountTopologyMutation: before=%d, after=%d", mutBefore, sink.mutationCount())
+	}
+	entries, err = mntns.MountTopology(ctx)
+	if err != nil {
+		t.Fatalf("MountTopology after remount failed: %v", err)
+	}
+	subEntry = nil
+	for i := range entries {
+		if entries[i].Mountpoint == "/mnt_target" {
+			subEntry = &entries[i]
+			break
+		}
+	}
+	if subEntry == nil || !subEntry.ReadOnly {
+		t.Errorf("Remount did not make submount ReadOnly: %+v", subEntry)
+	}
+
+	// 5. Test Mutation: Move branch (MS_MOVE)
+	addrMntMoved := mapString(t, task, "/mnt_moved")
+	popMntMoved := &vfs.PathOperation{Root: mntns.Root(ctx), Start: mntns.Root(ctx), Path: fspath.Parse("/mnt_moved")}
+	if err := task.Kernel().VFS().MkdirAt(ctx, task.Credentials(), popMntMoved, &vfs.MkdirOptions{Mode: 0755}); err != nil {
+		t.Fatalf("MkdirAt /mnt_moved failed: %v", err)
+	}
+	mutBefore = sink.mutationCount()
+	moveArgs := makeArgs(uintptr(addrMntDir), uintptr(addrMntMoved), 0, uintptr(unix.MS_MOVE), 0, 0)
+	_, _, err = Mount(task, unix.SYS_MOUNT, moveArgs)
+	if err != nil {
+		t.Fatalf("Move syscall failed: %v", err)
+	}
+	if sink.mutationCount() != mutBefore+1 {
+		t.Fatalf("Move did not emit MountTopologyMutation: before=%d, after=%d", mutBefore, sink.mutationCount())
+	}
+	entries, err = mntns.MountTopology(ctx)
+	if err != nil {
+		t.Fatalf("MountTopology after move failed: %v", err)
+	}
+	subEntry = nil
+	for i := range entries {
+		if entries[i].Mountpoint == "/mnt_moved" {
+			subEntry = &entries[i]
+			break
+		}
+	}
+	if subEntry == nil {
+		t.Fatalf("Moved mount /mnt_moved not found in topology: %+v", entries)
+	}
+
+	// 6. Test Mutation: Umount2
+	mutBefore = sink.mutationCount()
+	umountArgs := makeArgs(uintptr(addrMntMoved), 0, 0, 0, 0, 0)
+	_, _, err = Umount2(task, unix.SYS_UMOUNT2, umountArgs)
+	if err != nil {
+		t.Fatalf("Umount2 syscall failed: %v", err)
+	}
+	if sink.mutationCount() != mutBefore+1 {
+		t.Fatalf("Umount2 did not emit MountTopologyMutation: before=%d, after=%d", mutBefore, sink.mutationCount())
+	}
+	entries, err = mntns.MountTopology(ctx)
+	if err != nil {
+		t.Fatalf("MountTopology after umount2 failed: %v", err)
+	}
+	if len(entries) != 1 {
+		t.Fatalf("Expected 1 mount after umount2, got %d", len(entries))
+	}
+
+	// 7. Negative test: Failed Mount and Umount2 must NOT emit mutation
+	mutBefore = sink.mutationCount()
+	addrNonExistent := mapString(t, task, "/nonexistent_dir")
+	badMountArgs := makeArgs(uintptr(addrSource), uintptr(addrNonExistent), uintptr(addrType), 0, 0, 0)
+	_, _, err = Mount(task, unix.SYS_MOUNT, badMountArgs)
+	if err == nil {
+		t.Fatalf("Expected Mount to fail on nonexistent target")
+	}
+	if sink.mutationCount() != mutBefore {
+		t.Errorf("Failed Mount emitted unexpected mutation event!")
+	}
+
+	badUmountArgs := makeArgs(uintptr(addrNonExistent), 0, 0, 0, 0, 0)
+	_, _, err = Umount2(task, unix.SYS_UMOUNT2, badUmountArgs)
+	if err == nil {
+		t.Fatalf("Expected Umount2 to fail on nonexistent target")
+	}
+	if sink.mutationCount() != mutBefore {
+		t.Errorf("Failed Umount2 emitted unexpected mutation event!")
+	}
+}
