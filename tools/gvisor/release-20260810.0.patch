+	}
+	if resT1.ContextData.ThreadId == resT2.ContextData.ThreadId {
+		t.Errorf("M: expected distinct ThreadIDs, got %d", resT1.ContextData.ThreadId)
+	}
+	if resT1.ContextData.ThreadStartTimeNs == resT2.ContextData.ThreadStartTimeNs {
