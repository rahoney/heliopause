+func setupTestEnvironment(t *testing.T) (*kernel.Task, *kernel.Task, *recordingSink, uint64) {
+	t.Helper()
+	k, err := testutil.Boot()
+	if err != nil {
+		t.Fatalf("testutil.Boot failed: %v", err)
+	}
+
+	ctx := k.SupervisorContext()
+	creds := auth.CredentialsFromContext(ctx)
+
+	mntns, err := k.VFS().NewMountNamespace(ctx, creds, "", tmpfs.Name, &vfs.MountOptions{}, nil)
+	if err != nil {
+		t.Fatalf("NewMountNamespace failed: %v", err)
+	}
+	root := mntns.Root(ctx)
+	rootMountID := root.Mount().ID
+
+	// Create test file and test directory on root.
+	popFile := &vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("/testfile")}
+	fdFile, err := k.VFS().OpenAt(ctx, creds, popFile, &vfs.OpenOptions{Flags: linux.O_RDWR | linux.O_CREAT, Mode: 0644})
+	if err != nil {
+		t.Fatalf("Failed to create /testfile: %v", err)
+	}
+	fdFile.DecRef(ctx)
+
+	popDir := &vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("/testdir")}
+	if err := k.VFS().MkdirAt(ctx, creds, popDir, &vfs.MkdirOptions{Mode: 0755}); err != nil {
+		t.Fatalf("Failed to create /testdir: %v", err)
+	}
+
+	popChild := &vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("/testdir/childfile")}
+	fdChild, err := k.VFS().OpenAt(ctx, creds, popChild, &vfs.OpenOptions{Flags: linux.O_RDWR | linux.O_CREAT, Mode: 0644})
+	if err != nil {
+		t.Fatalf("Failed to create /testdir/childfile: %v", err)
+	}
+	fdChild.DecRef(ctx)
+
+	popSymlink := &vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("/symlink_to_child")}
+	if err := k.VFS().SymlinkAt(ctx, creds, popSymlink, "/testdir/childfile"); err != nil {
+		t.Fatalf("Failed to create /symlink_to_child: %v", err)
+	}
+
+	tg := k.GlobalInit()
+	task1, err := testutil.CreateTask(ctx, "task1", tg, mntns, root, root)
+	if err != nil {
+		t.Fatalf("CreateTask 1 failed: %v", err)
+	}
+	if _, err := task1.MemoryManager().SetMmapLayout(task1.Arch(), task1.Limits()); err != nil {
+		t.Fatalf("SetMmapLayout task1 failed: %v", err)
+	}
+
+	// Give a slight time separation to ensure distinct start times for thread correlation.
+	time.Sleep(10 * time.Millisecond)
+	task2, err := testutil.CreateTask(ctx, "task2", tg, mntns, root, root)
+	if err != nil {
+		t.Fatalf("CreateTask 2 failed: %v", err)
+	}
+	if _, err := task2.MemoryManager().SetMmapLayout(task2.Arch(), task2.Limits()); err != nil {
+		t.Fatalf("SetMmapLayout task2 failed: %v", err)
+	}
+
+	sink := &recordingSink{}
+	fields := seccheck.FieldSet{
+		Context: seccheck.MakeFieldMask(
+			seccheck.FieldCtxtTime,
+			seccheck.FieldCtxtThreadID,
+			seccheck.FieldCtxtThreadStartTime,
+			seccheck.FieldCtxtThreadGroupStartTime,
+		),
+	}
+	seccheck.Global.AppendSink(sink, []seccheck.PointReq{
+		{Pt: seccheck.PointOpenResult, Fields: fields},
+		{Pt: seccheck.PointMountTopologySnapshot, Fields: fields},
+		{Pt: seccheck.PointMountTopologyMutation, Fields: fields},
+	})
+
+	return task1, task2, sink, rootMountID
+}
