+func TestMountTopologySnapshotBoundsValidation(t *testing.T) {
+	validateBounds := func(entries []vfs.MountTopologyEntry) error {
+		if len(entries) > 64 {
+			return fmt.Errorf("mount topology exceeds 64 mounts")
+		}
+		for _, entry := range entries {
+			if len(entry.Mountpoint) > 512 || len(entry.FilesystemType) > 32 {
+				return fmt.Errorf("mount topology entry exceeds bounds")
+			}
+		}
+		return nil
+	}
+
+	// Test entries > 64
+	var entries65 []vfs.MountTopologyEntry
+	for i := uint64(1); i <= 65; i++ {
+		entries65 = append(entries65, vfs.MountTopologyEntry{ID: i, Mountpoint: "/", FilesystemType: "tmpfs"})
+	}
+	if err := validateBounds(entries65); err == nil || !strings.Contains(err.Error(), "exceeds 64 mounts") {
+		t.Errorf("expected >64 error, got %v", err)
+	}
+
+	// Test mountpoint > 512
+	longMountpoint := "/" + strings.Repeat("a", 513)
+	entriesLongMP := []vfs.MountTopologyEntry{{ID: 1, Mountpoint: longMountpoint, FilesystemType: "tmpfs"}}
+	if err := validateBounds(entriesLongMP); err == nil || !strings.Contains(err.Error(), "exceeds bounds") {
+		t.Errorf("expected long mountpoint error, got %v", err)
+	}
+
+	// Test fs type > 32
+	longFSType := strings.Repeat("b", 33)
+	entriesLongFS := []vfs.MountTopologyEntry{{ID: 1, Mountpoint: "/", FilesystemType: longFSType}}
+	if err := validateBounds(entriesLongFS); err == nil || !strings.Contains(err.Error(), "exceeds bounds") {
+		t.Errorf("expected long fs type error, got %v", err)
+	}
+
+	// Test proto size > 64 KiB
+	evtBig := pb.MountTopologySnapshot{
+		MountNamespaceId: 1,
+		SnapshotComplete: true,
+	}
+	for i := uint64(1); i <= 64; i++ {
+		evtBig.Mounts = append(evtBig.Mounts, &pb.MountTopologyEntry{
+			MountId:        i,
+			Mountpoint:     "/" + strings.Repeat("x", 510),
+			FilesystemType: strings.Repeat("y", 30),
+		})
+	}
+	t.Logf("64 max-sized entries proto size: %d bytes (limit 65536)", proto.Size(&evtBig))
+}
