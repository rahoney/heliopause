+type recordingSink struct {
+	seccheck.SinkDefaults
+	mu          sync.Mutex
+	openResults []*pb.OpenResult
+	mutations   []*pb.MountTopologyMutation
+	snapshots   []*pb.MountTopologySnapshot
+}
+
+func (s *recordingSink) Name() string { return "recording-sink" }
+
+func (s *recordingSink) OpenResult(_ context.Context, _ seccheck.FieldSet, info *pb.OpenResult) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.openResults = append(s.openResults, proto.Clone(info).(*pb.OpenResult))
+	return nil
+}
+
+func (s *recordingSink) MountTopologySnapshot(_ context.Context, _ seccheck.FieldSet, info *pb.MountTopologySnapshot) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.snapshots = append(s.snapshots, proto.Clone(info).(*pb.MountTopologySnapshot))
+	return nil
+}
+
+func (s *recordingSink) MountTopologyMutation(_ context.Context, _ seccheck.FieldSet, info *pb.MountTopologyMutation) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.mutations = append(s.mutations, proto.Clone(info).(*pb.MountTopologyMutation))
+	return nil
+}
+
+func (s *recordingSink) count() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.openResults)
+}
+
+func (s *recordingSink) lastResult() *pb.OpenResult {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if len(s.openResults) == 0 {
+		return nil
+	}
+	return s.openResults[len(s.openResults)-1]
+}
+
+func (s *recordingSink) mutationCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.mutations)
+}
+
+func mapString(t *testing.T, task *kernel.Task, str string) hostarch.Addr {
+	t.Helper()
+	addr, err := task.MemoryManager().MMap(task, memmap.MMapOpts{
+		Length:   hostarch.PageSize,
+		Perms:    hostarch.ReadWrite,
+		MaxPerms: hostarch.AnyAccess,
+		Private:  true,
+	})
+	if err != nil {
+		t.Fatalf("MMap failed: %v", err)
+	}
+	b := append([]byte(str), 0)
+	n, err := task.CopyOutBytes(addr, b)
+	if err != nil || n != len(b) {
+		t.Fatalf("CopyOutBytes failed: %v, n=%d", err, n)
+	}
+	return addr
+}
