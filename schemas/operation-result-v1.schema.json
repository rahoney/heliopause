{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahoney/heliopause/schemas/operation-result-v1.schema.json",
  "title": "Heliopause Operation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "operation", "operation_status", "artifact", "checks", "evidence_references"],
  "properties": {
    "schema_version": { "const": "helox.operation-result/v1" },
    "operation_id": { "type": "string", "pattern": "^op_[a-z2-7]{26}$" },
    "operation": { "const": "INSPECT" },
    "operation_status": { "enum": ["COMPLETED", "FAILED"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome"],
      "properties": {
        "id": { "type": "string", "pattern": "^run_[a-z2-7]{26}$" },
        "outcome": { "enum": ["COMPLETED", "FAILED"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "resolved_identity": { "$ref": "#/$defs/identity" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "evidence_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_reference" }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation_status": { "const": "COMPLETED" } }, "required": ["operation_status"] },
      "then": { "required": ["run", "policy"], "not": { "required": ["error"] } },
      "else": { "required": ["error"], "not": { "required": ["policy"] } }
    }
  ],
  "$defs": {
    "bounded_text": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "normalized_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 64 },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "$ref": "#/$defs/normalized_id" },
        "locator": { "$ref": "#/$defs/bounded_text" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "version", "variant"],
      "properties": {
        "source_id": { "$ref": "#/$defs/normalized_id" },
        "name": { "$ref": "#/$defs/bounded_text" },
        "version": { "$ref": "#/$defs/bounded_text" },
        "variant": { "$ref": "#/$defs/bounded_text" }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "capability", "execution_status"],
      "properties": {
        "id": { "$ref": "#/$defs/normalized_id" },
        "kind": { "enum": ["VERIFICATION", "INSPECTION"] },
        "required": { "type": "boolean" },
        "capability": { "enum": ["SUPPORTED", "UNSUPPORTED"] },
        "execution_status": { "enum": ["COMPLETED", "FAILED", "INCOMPLETE", "NOT_EXECUTED", "UNAVAILABLE"] },
        "limitation_code": { "$ref": "#/$defs/reason_code" }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handle"],
      "properties": {
        "id": { "$ref": "#/$defs/normalized_id" },
        "handle": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "id", "version", "reasons"],
      "properties": {
        "decision": { "enum": ["ALLOW", "MANUAL_REVIEW", "BLOCK"] },
        "id": { "$ref": "#/$defs/normalized_id" },
        "version": { "type": "integer", "minimum": 1 },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason_code" } }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/reason_code" },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
