{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahoney/heliopause/schemas/operation-result-v2.schema.json",
  "title": "Heliopause Operation Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "operation",
    "operation_status",
    "artifact",
    "checks",
    "evidence_references"
  ],
  "properties": {
    "schema_version": {
      "const": "helox.operation-result/v2"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-z2-7]{26}$"
    },
    "operation": {
      "enum": [
        "INSPECT",
        "INSTALL",
        "UPDATE"
      ]
    },
    "operation_status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "NOT_PERFORMED"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run_[a-z2-7]{26}$"
        },
        "outcome": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "resolved_identity": {
          "$ref": "#/$defs/identity"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "target": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2048
    },
    "promotion_status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "NOT_PERFORMED"
      ]
    },
    "verified_set": {
      "$ref": "#/$defs/verified_set"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "check_plan": {
      "$ref": "#/$defs/check_plan"
    },
    "check_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check_plan"
      }
    },
    "graph_static_not_ready": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph_static_diagnostic"
      }
    },
    "graph_dynamic_install_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph_dynamic_diagnostic"
      }
    },
    "dependency_policy_attribution": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency_policy_diagnostic"
      }
    },
    "inspection_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "INSPECT"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "operation_status": {
              "const": "COMPLETED"
            }
          },
          "required": [
            "operation_status"
          ]
        },
        "then": {
          "required": [
            "run",
            "policy"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "target"
                ]
              },
              {
                "required": [
                  "verified_set"
                ]
              },
              {
                "required": [
                  "promotion_status"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "policy"
            ]
          }
        }
      },
      "else": {
        "required": [
          "target",
          "promotion_status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "operation_status": {
                  "const": "COMPLETED"
                }
              },
              "required": [
                "operation_status"
              ]
            },
            "then": {
              "required": [
                "policy",
                "verified_set"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "error"
                    ]
                  },
                  {
                    "required": [
                      "run"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation_status": {
                  "const": "NOT_PERFORMED"
                }
              },
              "required": [
                "operation_status"
              ]
            },
            "then": {
              "required": [
                "policy"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "error"
                    ]
                  },
                  {
                    "required": [
                      "verified_set"
                    ]
                  },
                  {
                    "required": [
                      "run"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation_status": {
                  "const": "FAILED"
                }
              },
              "required": [
                "operation_status"
              ]
            },
            "then": {
              "required": [
                "error"
              ],
              "not": {
                "required": [
                  "run"
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "normalized_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 64
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/normalized_id"
        },
        "locator": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "version",
        "variant"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/normalized_id"
        },
        "name": {
          "$ref": "#/$defs/bounded_text"
        },
        "version": {
          "$ref": "#/$defs/bounded_text"
        },
        "variant": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required",
        "capability",
        "execution_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/normalized_id"
        },
        "kind": {
          "enum": [
            "VERIFICATION",
            "INSPECTION"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "capability": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED"
          ]
        },
        "execution_status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "INCOMPLETE",
            "NOT_EXECUTED",
            "UNAVAILABLE"
          ]
        },
        "limitation_code": {
          "$ref": "#/$defs/reason_code"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "node": {
          "$ref": "#/$defs/normalized_id"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[a-z2-7]{26}$"
        }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/normalized_id"
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "id",
        "version",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ALLOW",
            "MANUAL_REVIEW",
            "BLOCK"
          ]
        },
        "id": {
          "$ref": "#/$defs/normalized_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      }
    },
    "verified_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "sbom_handle",
        "entry_count"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sbom_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "staging_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reason_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "check_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required",
        "profile_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/normalized_id"
        },
        "kind": {
          "enum": [
            "VERIFICATION",
            "INSPECTION"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "check_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "subject",
        "sha256",
        "requirements"
      ],
      "properties": {
        "schema_version": {
          "const": "helox.check-plan/v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[a-z2-7]{26}$"
        },
        "subject": {
          "$ref": "#/$defs/identity"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check_requirement"
          }
        }
      }
    },
    "graph_static_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "package",
        "version",
        "source",
        "variant",
        "cause"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/normalized_id"
        },
        "package": {
          "$ref": "#/$defs/bounded_text"
        },
        "version": {
          "$ref": "#/$defs/bounded_text"
        },
        "source": {
          "$ref": "#/$defs/normalized_id"
        },
        "variant": {
          "$ref": "#/$defs/bounded_text"
        },
        "cause": {
          "$ref": "#/$defs/bounded_text"
        },
        "stage": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    },
    "graph_dynamic_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "package",
        "version",
        "source",
        "variant",
        "reason",
        "failure_class"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/normalized_id"
        },
        "package": {
          "$ref": "#/$defs/bounded_text"
        },
        "version": {
          "$ref": "#/$defs/bounded_text"
        },
        "source": {
          "$ref": "#/$defs/normalized_id"
        },
        "variant": {
          "$ref": "#/$defs/bounded_text"
        },
        "reason": {
          "$ref": "#/$defs/reason_code"
        },
        "phase": {
          "$ref": "#/$defs/bounded_text"
        },
        "failure_class": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    },
    "dependency_policy_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "package",
        "version",
        "source",
        "entry_policy_decision",
        "entry_policy_reasons",
        "dynamic_finding_codes"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/normalized_id"
        },
        "package": {
          "$ref": "#/$defs/bounded_text"
        },
        "version": {
          "$ref": "#/$defs/bounded_text"
        },
        "source": {
          "$ref": "#/$defs/normalized_id"
        },
        "entry_policy_decision": {
          "enum": [
            "ALLOW",
            "MANUAL_REVIEW",
            "BLOCK"
          ]
        },
        "entry_policy_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        },
        "dynamic_finding_codes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      }
    }
  }
}
